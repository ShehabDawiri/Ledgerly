# Copy to .env and adjust. Read by `docker compose`; NEVER commit the real .env.
# Running locally with `./gradlew bootRun` needs none of this -- it defaults to
# in-memory H2 with no credentials.

# --- PostgreSQL (used by compose.yaml) -------------------------------------
POSTGRES_DB=ledgerly
POSTGRES_USER=ledgerly
# Use a real password. This placeholder is not a secret and must be changed.
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# --- Application -----------------------------------------------------------
APP_PORT=8080

# --- Overrides understood by the app (see application.properties) -----------
# DB_URL=jdbc:postgresql://localhost:5432/ledgerly
# DB_USERNAME=ledgerly
# DB_PASSWORD=
# DDL_AUTO=update
# SHOW_SQL=false
# H2_CONSOLE_ENABLED=false
# TRANSFER_MAX_ATTEMPTS=10
# TRANSFER_BASE_BACKOFF_MILLIS=5
# TRANSFER_MAX_BACKOFF_MILLIS=250
# IDEMPOTENCY_RETENTION=PT24H
# IDEMPOTENCY_CLEANUP_ENABLED=true
