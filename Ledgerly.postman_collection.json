              "mode": "raw",
              "raw": "{\n  \"fromId\": \"{{fromAccountId}}\",\n  \"toId\": \"{{toAccountId}}\",\n  \"amount\": \"-50.00\",\n  \"idempotencyId\": \"pm-negative-{{$randomUUID}}\"\n}",
