    {
      "name": "Transfers",
      "description": "The write path. Every accepted transfer appends a DEBIT and a matching CREDIT event sharing one transferId, and records its idempotency key in the same transaction.",
      "item": [
        {
          "name": "Transfer money",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transfers"
              ]
            },
            "description": "Moves money. The pre-request script mints a fresh idempotencyId and stores it, so the next request ('Replay the same request') can send the exact same payload again.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromId\": \"{{fromAccountId}}\",\n  \"toId\": \"{{toAccountId}}\",\n  \"amount\": \"100.00\",\n  \"idempotencyId\": \"{{idempotencyId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh key per run: a client would normally generate this once per logical transfer",
                  "// and reuse it across retries.",
                  "const key = 'pm-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8);",
                  "pm.collectionVariables.set('idempotencyId', key);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const r = pm.response.json();",
                  "pm.test('succeeded', () => pm.expect(r.success).to.be.true);",
                  "pm.test('returns a transferId', () => pm.expect(r.transferId).to.be.a('string'));",
                  "",
                  "// Remember the result so the replay request can assert it comes back identical.",
                  "pm.collectionVariables.set('lastTransferId', r.transferId);",
                  "pm.collectionVariables.set('lastFromBalance', r.fromBalance);",
                  "pm.collectionVariables.set('lastToBalance', r.toBalance);"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay the same request (idempotency)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transfers"
              ]
            },
            "description": "Identical payload, identical idempotencyId - no pre-request script, so the key is NOT regenerated. The server returns the original result from processed_request instead of moving money a second time. Send it as many times as you like; the ledger does not change.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromId\": \"{{fromAccountId}}\",\n  \"toId\": \"{{toAccountId}}\",\n  \"amount\": \"100.00\",\n  \"idempotencyId\": \"{{idempotencyId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const r = pm.response.json();",
                  "pm.test('same transferId as the original', () =>",
                  "    pm.expect(r.transferId).to.eql(pm.collectionVariables.get('lastTransferId')));",
                  "pm.test('same balances as the original', () => {",
                  "    pm.expect(String(r.fromBalance)).to.eql(String(pm.collectionVariables.get('lastFromBalance')));",
                  "    pm.expect(String(r.toBalance)).to.eql(String(pm.collectionVariables.get('lastToBalance')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get transfer by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers/{{lastTransferId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transfers",
                "{{lastTransferId}}"
              ]
            },
            "description": "Both legs of one transfer: exactly one DEBIT and one matching CREDIT sharing a transferId. Uses the id captured by 'Transfer money'."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const legs = pm.response.json();",
                  "pm.test('has exactly two legs', () => pm.expect(legs).to.have.lengthOf(2));",
                  "pm.test('one DEBIT and one CREDIT', () => {",
                  "    const types = legs.map(l => l.eventType).sort();",
                  "    pm.expect(types).to.eql(['CREDIT', 'DEBIT']);",
                  "});",
                  "pm.test('both legs move the same amount', () =>",
                  "    pm.expect(Number(legs[0].amount)).to.eql(Number(legs[1].amount)));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get transfer by id - unknown (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers/00000000-0000-0000-0000-000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transfers",
                "00000000-0000-0000-0000-000000000000"
              ]
            },
            "description": "Unknown transferId."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('TRANSFER_NOT_FOUND', () => pm.expect(pm.response.json().errorCode).to.eql('TRANSFER_NOT_FOUND'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List transfer events (paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers?page=0&size=50&sort=id,desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transfers"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "50"
                },
                {
                  "key": "sort",
                  "value": "id,desc"
                }
              ]
            },
            "description": "The event log. Each transfer contributes exactly two rows - one DEBIT, one CREDIT - sharing a transferId. OPENING rows are the seeded starting balances."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test('events are DEBIT / CREDIT / OPENING', () =>",
                  "    page.content.forEach(e => pm.expect(['DEBIT', 'CREDIT', 'OPENING']).to.include(e.eventType)));"
                ]
              }
            }
          ]
        },
        {
          "name": "List processed requests (paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers/processed?page=0&size=50&sort=id,desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transfers",
                "processed"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "50"
                },
                {
                  "key": "sort",
                  "value": "id,desc"
                }
              ]
            },
            "description": "The idempotency records. One row per accepted idempotencyId, holding the result that gets replayed on a retry. The unique constraint on idempotency_id is what makes this safe under concurrency."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Reconciliation",
      "description": "The headline proof. Recomputes every balance from the event log and checks that money was only ever moved, never created or destroyed.",
      "item": [
        {
          "name": "Reconcile the ledger",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reconcile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "reconcile"
              ]
            },
            "description": "200 when the ledger balances, 409 when it does not - so this doubles as a CI assertion.\n\n`discrepancies` lists any account whose stored balance disagrees with its event history (should always be empty). `totalDebited` must equal `totalCredited`. `retriesAbsorbed` and `idempotentReplays` are live counters - run the stress test, then hit this to see them climb."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK - the ledger balances', () => pm.response.to.have.status(200));",
                  "",
                  "const r = pm.response.json();",
                  "pm.test('no account disagrees with its event history', () =>",
                  "    pm.expect(r.discrepancies).to.be.an('array').that.is.empty);",
                  "pm.test('no money created or destroyed', () => {",
                  "    pm.expect(r.conserved).to.be.true;",
                  "    pm.expect(Number(r.totalDebited)).to.eql(Number(r.totalCredited));",
                  "});",
                  "pm.test('stored total matches derived total', () =>",
                  "    pm.expect(Number(r.storedTotal)).to.eql(Number(r.derivedTotal)));",
                  "",
                  "console.log('accounts=' + r.accountsChecked +",
                  "            ' transfers=' + r.transfersRecorded +",
                  "            ' retriesAbsorbed=' + r.retriesAbsorbed +",
                  "            ' idempotentReplays=' + r.idempotentReplays);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Error cases",
      "description": "Every failure mode returns the same {errorCode, message} shape from GlobalExceptionHandler. Nothing is written to the ledger for any of these.",
      "item": [
        {
          "name": "Self transfer (400 SELF_TRANSFER)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transfers"
              ]
            },
            "description": "Same account on both sides. Rejected before any work happens - otherwise it would append a meaningless DEBIT/CREDIT pair against one account.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromId\": \"{{fromAccountId}}\",\n  \"toId\": \"{{fromAccountId}}\",\n  \"amount\": \"5.00\",\n  \"idempotencyId\": \"pm-self-{{$randomUUID}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('SELF_TRANSFER', () => pm.expect(pm.response.json().errorCode).to.eql('SELF_TRANSFER'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Idempotency key reused with different parameters (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transfers"
              ]
            },
            "description": "Sends the key from 'Transfer money' again, but with a different amount. The server refuses rather than replaying the original result - returning the 100.00 result for a 500.00 request would silently swallow a client bug. Run 'Transfer money' first.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromId\": \"{{fromAccountId}}\",\n  \"toId\": \"{{toAccountId}}\",\n  \"amount\": \"500.00\",\n  \"idempotencyId\": \"{{idempotencyId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('IDEMPOTENCY_KEY_REUSED', () =>",
                  "    pm.expect(pm.response.json().errorCode).to.eql('IDEMPOTENCY_KEY_REUSED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Insufficient funds (409 INSUFFICIENT_FUNDS)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transfers"
              ]
            },
            "description": "More than the account holds. The invariant lives on the Account entity itself (Account.debit), not in the service, so it cannot be bypassed by a new caller.",
            "body": {
